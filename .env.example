# Copy to .env and replace both values. Never commit .env.
# Generate strong values with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
LEDGERFORGE_ADMIN_TOKEN=change-me-to-at-least-32-random-characters
FRAUD_SERVICE_TOKEN=change-me-to-at-least-32-random-characters
REDIS_PASSWORD=change-me-to-a-long-random-value
# Optional: read-only token for Prometheus scraping (32+ chars, different from the admin token)
LEDGERFORGE_METRICS_TOKEN=
