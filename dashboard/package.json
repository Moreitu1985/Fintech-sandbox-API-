{
  "name": "ledgerforge-dashboard",
  "version": "0.4.0",
  "private": true,
  "description": "Developer dashboard for LedgerForge: accounts, statements, transfers, webhooks and ledger integrity.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/dashboard/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ledgerforge/sdk": "file:../sdk/typescript",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
