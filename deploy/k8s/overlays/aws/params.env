# Example values. Replace with the real ones from Terraform:
#   terraform -chdir=deploy/terraform output -raw kustomize_params > deploy/k8s/overlays/aws/params.env
AWS_REGION=af-south-1
VPC_CIDR=10.40.0.0/16
LEDGER_API_IMAGE=123456789012.dkr.ecr.af-south-1.amazonaws.com/ledgerforge/ledger-api:0.3.0
FRAUD_SERVICE_IMAGE=123456789012.dkr.ecr.af-south-1.amazonaws.com/ledgerforge/fraud-service:0.3.0
DATASOURCE_URL=jdbc:postgresql://ledgerforge-prod.abc123.af-south-1.rds.amazonaws.com:5432/ledgerforge?sslmode=verify-full&sslrootcert=/etc/ledgerforge/rds/global-bundle.pem
REDIS_HOST=master.ledgerforge-prod.abc123.afs1.cache.amazonaws.com
SECRETS_READER_ROLE_ARN=arn:aws:iam::123456789012:role/ledgerforge-prod-secrets-reader
SECRETS_PREFIX=ledgerforge/prod
ACM_CERTIFICATE_ARN=arn:aws:acm:af-south-1:123456789012:certificate/00000000-0000-0000-0000-000000000000
API_HOSTNAME=api.example.com
