SPRING_PROFILES_ACTIVE=prod
# Secrets are files, not environment variables: each file in this folder becomes a Spring property
# named after the file (e.g. ledgerforge.admin-token), so they never appear in `env` or process listings.
SPRING_CONFIG_IMPORT=optional:configtree:/etc/ledgerforge/secrets/
LEDGERFORGE_OAUTH_SIGNING_KEY_FILE=/etc/ledgerforge/oauth/signing.key
# Readiness means "can serve": the database must answer. Redis is left out on purpose: the rate
# limiter has its own fail-open/closed policy and circuit breaker.
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db
REDIS_HEALTH_ENABLED=true
RATE_LIMIT_STORE=redis
# Mutual TLS to the fraud service with cert-manager's certificates (see mtls-certificates.yaml).
FRAUD_ENABLED=true
FRAUD_FAIL_OPEN=false
FRAUD_SERVICE_URL=https://fraud-service:8090
FRAUD_SSL_BUNDLE=fraudclient
SPRING_SSL_BUNDLE_PEM_FRAUDCLIENT_KEYSTORE_CERTIFICATE=file:/etc/ledgerforge/mtls/tls.crt
SPRING_SSL_BUNDLE_PEM_FRAUDCLIENT_KEYSTORE_PRIVATEKEY=file:/etc/ledgerforge/mtls/tls.key
SPRING_SSL_BUNDLE_PEM_FRAUDCLIENT_TRUSTSTORE_CERTIFICATE=file:/etc/ledgerforge/mtls/ca.crt
# A load balancer in front sets X-Forwarded-For; trust it (internal addresses only) so per-IP limits see clients.
SERVER_FORWARD_HEADERS_STRATEGY=native
TRACING_SAMPLING=0.1
# Overlays set these:
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ledgerforge
REDIS_HOST=redis
REDIS_PORT=6379
